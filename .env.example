# .env.example
# Server side only. Never expose these to the client bundle.
GEMINI_API_KEY=

# Live rosters (NFL.com via Firecrawl). Without a key the server uses cache, then data/snapshots/rosters.json.
FIRECRAWL_API_KEY=
# Season to request. Leave empty to use the provider's current league season.
ROSTER_SEASON=
# Hours before a cached team roster is refetched. Each refetch costs one provider call.
ROSTER_CACHE_TTL_HOURS=168
# Required to call POST /api/rosters/refresh. Leave empty to disable that route.
ROSTER_ADMIN_TOKEN=
